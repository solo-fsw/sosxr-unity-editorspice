{
  "name": "com.sosxr.editorspice",
  "version": "0.7.0",
  "displayName": "EditorSpice",
  "description": "This is a package that contains some simple helper scripts for the Unity Editor.",
  "documentationUrl": "https://github.com/solo-fsw/sosxr-unity-editorspice",
  "unity": "6000.4",
  "dependencies": {
    "com.unity.xr.interaction.toolkit": "3.0.7",
    "com.unity.recorder": "5.1.2",
    "com.unity.editorcoroutines": "1.0.0"
  },
  "keywords": [
    "Unity",
    "Helpers",
    "Editor",
    "Tools"
  ],
  "samples": [
    {
      "displayName": "Spice",
      "description": "Contains Spice samples",
      "path": "Samples~/Spice"
    },
    {
      "displayName": "Mutable",
      "description": "Contains Spice that would've fit as a part of the regular package, were it not that they require some changes depending on your situation",
      "path": "Samples~/Mutable"
    },
    {
      "displayName": "Unity Event Visualizer",
      "description": "A tool to visualize UnityEvents in the editor.",
      "path": "Samples~/UnityEventVisualiser"
    }
  ],
  "author": {
    "name": "SOSXR",
    "email": "sosxr@fsw.leidenuniv.nl",
    "url": "https://researchwiki.solo.universiteitleiden.nl/xwiki/bin/view/Main/"
  },
  "changelogUrl": "https://github.com/solo-fsw/sosxr-unity-editorspice/blob/main/CHANGELOG.md"
}
